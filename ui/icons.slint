// Stroke icons drawn on a 24×24 grid (original simple shapes, 1.5px stroke).
import { Theme } from "theme.slint";

export component Icon inherits Path {
    in property <string> name;
    in property <color> color: Theme.fg-primary;
    in property <length> size: 18px;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: color;
    stroke-width: 1.6px;
    fill: transparent;
    commands:
        name == "back" ? "M15 18 L9 12 L15 6" :
        name == "forward" ? "M9 18 L15 12 L9 6" :
        name == "grid" ? "M4 4 H10 V10 H4 Z M14 4 H20 V10 H14 Z M4 14 H10 V20 H4 Z M14 14 H20 V20 H14 Z" :
        name == "list" ? "M8.5 6 H20 M8.5 12 H20 M8.5 18 H20 M4 6 H5.5 M4 12 H5.5 M4 18 H5.5" :
        name == "columns" ? "M3 5 H21 V19 H3 Z M9 5 V19 M15 5 V19" :
        name == "star" ? "M12 3.5 L14.5 8.8 L20.2 9.4 L15.9 13.2 L17.2 18.9 L12 16 L6.8 18.9 L8.1 13.2 L3.8 9.4 L9.5 8.8 Z" :
        name == "connect" ? "M9.5 14.5 L14.5 9.5 M11 6.5 L12.8 4.7 A3.3 3.3 0 0 1 17.5 4.7 L19.3 6.5 A3.3 3.3 0 0 1 19.3 11.2 L17.5 13 M13 17.5 L11.2 19.3 A3.3 3.3 0 0 1 6.5 19.3 L4.7 17.5 A3.3 3.3 0 0 1 4.7 12.8 L6.5 11" :
        name == "sync" ? "M19.5 12 A7.5 7.5 0 0 1 6.2 16.8 M4.5 12 A7.5 7.5 0 0 1 17.8 7.2 M18 3.5 V7.5 H14 M6 20.5 V16.5 H10" :
        name == "copy" ? "M8.5 8.5 H19.5 V19.5 H8.5 Z M4.5 15.5 V4.5 H15.5" :
        name == "folder-plus" ? "M3.5 7 A1.5 1.5 0 0 1 5 5.5 H9.5 L11.5 7.5 H19 A1.5 1.5 0 0 1 20.5 9 V17.5 A1.5 1.5 0 0 1 19 19 H5 A1.5 1.5 0 0 1 3.5 17.5 Z M12 10.5 V16 M9.25 13.25 H14.75" :
        name == "trash" ? "M4 7 H20 M9.5 7 V4.5 H14.5 V7 M6.2 7 L7.2 19.5 H16.8 L17.8 7 M10 11 V16 M14 11 V16" :
        name == "search" ? "M17.5 10.5 A7 7 0 1 1 3.5 10.5 A7 7 0 1 1 17.5 10.5 M15.6 15.6 L20.5 20.5" :
        name == "home" ? "M3.5 11 L12 4 L20.5 11 M5.5 9.5 V20 H18.5 V9.5 M10 20 V14 H14 V20" :
        name == "drive" ? "M3.5 13.5 H20.5 V19 H3.5 Z M3.5 13.5 L6.5 5.5 H17.5 L20.5 13.5 M7 16.25 H8.5" :
        name == "download" ? "M12 4 V15 M7.5 10.5 L12 15 L16.5 10.5 M5 19.5 H19" :
        name == "desktop" ? "M3.5 5 H20.5 V16 H3.5 Z M9 20 H15 M12 16 V20" :
        name == "doc" ? "M6 3.5 H14 L18 7.5 V20.5 H6 Z M14 3.5 V7.5 H18" :
        name == "image" ? "M3.5 5 H20.5 V19 H3.5 Z M3.5 16 L8.5 11 L12.5 15 L15.5 12 L20.5 17 M15.5 8.5 H16.5" :
        name == "music" ? "M9 18 A2.5 2.5 0 1 1 4 18 A2.5 2.5 0 1 1 9 18 M9 18 V5 L19 3.5 V16 M19 16 A2.5 2.5 0 1 1 14 16 A2.5 2.5 0 1 1 19 16" :
        name == "video" ? "M3.5 6 H15.5 V18 H3.5 Z M15.5 10 L20.5 7 V17 L15.5 14" :
        name == "info" ? "M20.5 12 A8.5 8.5 0 1 1 3.5 12 A8.5 8.5 0 1 1 20.5 12 M12 11 V16.5 M12 7.5 V8.5" :
        name == "compare" ? "M7 4 V20 M7 20 L4 17 M7 20 L10 17 M17 20 V4 M17 4 L14 7 M17 4 L20 7" :
        name == "warning" ? "M12 4 L21 19.5 H3 Z M12 10 V14 M12 16.5 V17.5" :
        name == "chevron-down" ? "M6 9 L12 15 L18 9" :
        name == "chevron-right" ? "M10 6 L16 12 L10 18" :
        name == "sort-up" ? "M7 14 L12 9 L17 14" :
        name == "sort-down" ? "M7 10 L12 15 L17 10" :
        name == "folder" ? "M3.5 7 A1.5 1.5 0 0 1 5 5.5 H9.5 L11.5 7.5 H19 A1.5 1.5 0 0 1 20.5 9 V17.5 A1.5 1.5 0 0 1 19 19 H5 A1.5 1.5 0 0 1 3.5 17.5 Z" :
        "M6 3.5 H14 L18 7.5 V20.5 H6 Z M14 3.5 V7.5 H18";
}

// Filled file-type glyph used in lists and grids (folder = filled, files = outlined page with type badge).
export component FileGlyph inherits Rectangle {
    in property <string> kind; // folder | image | audio | video | archive | code | doc
    in property <length> size: 16px;
    width: size;
    height: size;
    Path {
        width: size;
        height: size;
        viewbox-width: 24;
        viewbox-height: 24;
        visible: kind == "folder";
        fill: Theme.folder;
        stroke: transparent;
        commands: "M2.5 6.5 A1.5 1.5 0 0 1 4 5 H9.2 L11.2 7 H20 A1.5 1.5 0 0 1 21.5 8.5 V18 A1.5 1.5 0 0 1 20 19.5 H4 A1.5 1.5 0 0 1 2.5 18 Z";
    }
    Path {
        width: size;
        height: size;
        viewbox-width: 24;
        viewbox-height: 24;
        visible: kind != "folder";
        fill: Theme.surface0;
        stroke: kind == "image" || kind == "image-noprev" ? Theme.peach : kind == "audio" ? Theme.green : kind == "video" ? Theme.red
            : kind == "archive" ? Theme.yellow : kind == "code" ? Theme.mauve : Theme.subtext0;
        stroke-width: size > 32px ? 1px : 1.4px;
        commands: "M6 2.5 H14 L19 7.5 V21.5 H6 Z M14 2.5 V7.5 H19";
    }
}
